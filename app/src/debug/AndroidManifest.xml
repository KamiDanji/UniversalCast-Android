<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only: lets adb simulate a phone remote key (action com.universalcast.debug.KEY, string extra key). -->
        <receiver
            android:name="com.universalcast.receiver.DebugKeyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.universalcast.debug.KEY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
